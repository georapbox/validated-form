{
  "name": "@georapbox/validated-form",
  "version": "2.0.0",
  "description": "A Web Component that wraps native HTML form validation and surfaces the browser's validation messages as accessible inline errors.",
  "type": "module",
  "main": "dist/validated-form.js",
  "unpkg": "dist/validated-form.js",
  "types": "dist/validated-form.d.ts",
  "customElements": "dist/custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/validated-form.d.ts",
      "import": "./dist/validated-form.js"
    },
    "./define": {
      "types": "./dist/validated-form.d.ts",
      "import": "./dist/validated-form-defined.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "files": [
    "/src",
    "/dist"
  ],
  "scripts": {
    "lint": "eslint",
    "format": "prettier --ignore-unknown --write .",
    "test": "web-test-runner",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "npm run test -- --coverage",
    "types": "tsc --project tsconfig.json",
    "dev:esbuild": "node ./scripts/dev.mjs",
    "dev": "npm-run-all clean dev:esbuild",
    "serve:dev": "web-dev-server --node-resolve --open /docs/ --watch",
    "start": "npm-run-all --parallel \"serve:dev -- {1}\" dev",
    "build:esbuild": "node ./scripts/build.mjs",
    "build": "npm-run-all clean build:esbuild",
    "analyze": "custom-elements-manifest analyze",
    "clean": "rimraf dist",
    "prepublishOnly": "npm-run-all clean lint test build types analyze"
  },
  "keywords": [
    "custom element",
    "web component",
    "form",
    "validation",
    "error messages",
    "Constraint Validation API"
  ],
  "author": {
    "name": "George Raptis",
    "email": "georapbox@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georapbox/validated-form.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/georapbox/validated-form/issues"
  },
  "homepage": "https://github.com/georapbox/validated-form#readme",
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "~0.11.0",
    "@eslint/js": "~9.39.4",
    "@esm-bundle/chai": "~4.3.4-fix.0",
    "@open-wc/testing": "~4.0.0",
    "@types/node": "~25.0.3",
    "@web/dev-server": "~0.4.6",
    "@web/test-runner": "~0.20.2",
    "@web/test-runner-playwright": "~0.11.1",
    "esbuild": "~0.27.3",
    "eslint": "~9.39.4",
    "eslint-plugin-wc": "~3.1.0",
    "globals": "~17.4.0",
    "npm-run-all": "~4.1.5",
    "prettier": "~3.8.1",
    "rimraf": "~6.1.3",
    "sinon": "~21.0.2",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
