{
  "include": ["src/**/*"],
  "compilerOptions": {
    "strict": true,
    "target": "es2015",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist"
  }
}
